101 WAVE "assets/game_started.wav"
#include "session-auth.generated.rc"
#include <winver.h>
#include "tool_version.hpp"
1 VERSIONINFO
 FILEVERSION WHT_VERSION_FILE
 PRODUCTVERSION WHT_VERSION_FILE
