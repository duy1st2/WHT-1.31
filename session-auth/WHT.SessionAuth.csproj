<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="MongoDB.Driver" Version="3.11.0" /></ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="auth/mongo.key" LogicalName="WHT.MongoKey" />
    <EmbeddedResource Include="auth/mongo.enc" LogicalName="WHT.MongoConfiguration" />
  </ItemGroup>
</Project>
